rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function membership(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    function isMembershipActive(orgId) {
      return signedIn()
        && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid))
        && (!('status' in membership(orgId).data) || membership(orgId).data.status == 'active');
    }

    function isOrganizationEnabled(orgId) {
      let organization = get(/databases/$(database)/documents/organizations/$(orgId)).data;
      return (!('platformStatus' in organization) || organization.platformStatus != 'suspended')
        && (!('subscription' in organization)
          || !('expiresAt' in organization.subscription)
          || organization.subscription.expiresAt >= request.time);
    }

    function isMember(orgId) {
      return isMembershipActive(orgId) && isOrganizationEnabled(orgId);
    }

    function hasRole(orgId, roles) {
      return isMember(orgId) && membership(orgId).data.role in roles;
    }

    function canEdit(orgId) {
      return hasRole(orgId, ['admin', 'editor']);
    }

    function isAdmin(orgId) {
      return hasRole(orgId, ['admin']);
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId;
      allow read, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /organizations/{orgId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read: if isMembershipActive(orgId);
      allow update: if isAdmin(orgId);
      allow delete: if false;

      match /members/{memberId} {
        allow read: if isMember(orgId)
          || (signedIn() && memberId == request.auth.uid && isMembershipActive(orgId));
        allow create: if isAdmin(orgId) && memberId != request.auth.uid;
        allow update, delete: if isAdmin(orgId) && memberId != request.auth.uid;
      }

      match /invitations/{invitationId} {
        allow read, create, update, delete: if isAdmin(orgId);
      }

      match /settings/{settingId} {
        allow read: if isMember(orgId);
        allow write: if isAdmin(orgId);
      }

      match /catalogs/{catalogId} {
        allow read: if isMember(orgId);
        allow write: if isAdmin(orgId);
      }

      match /cases/{caseId} {
        allow read: if isMember(orgId);
        allow create, update: if canEdit(orgId)
          && request.resource.data.organizationId == orgId;
        allow delete: if canEdit(orgId);

        match /parcels/{parcelId} {
          allow read: if isMember(orgId);
          allow write: if canEdit(orgId);
        }

        match /sections/{sectionId} {
          allow read: if isMember(orgId);
          allow write: if canEdit(orgId);
        }

        match /notes/{noteId} {
          allow read: if isMember(orgId);
          allow write: if canEdit(orgId);
        }

        match /attachments/{attachmentId} {
          allow read: if isMember(orgId);
          allow write: if canEdit(orgId);
        }

        match /events/{eventId} {
          allow read: if isMember(orgId);
          allow write: if false;
        }

        match /documents/{documentId} {
          allow read: if isMember(orgId);
          allow write: if false;
        }

        match /notifications/{notificationId} {
          allow read: if isMember(orgId);
          allow create, delete: if false;
          allow update: if isMember(orgId)
            && resource.data.recipientId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
        }
      }
    }
  }
}
