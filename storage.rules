rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function membership(orgId) {
      return firestore.get(/databases/(default)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    function platformAdmin() {
      return firestore.get(/databases/(default)/documents/platformAdmins/$(request.auth.uid));
    }

    function isMembershipActive(orgId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/organizations/$(orgId)/members/$(request.auth.uid))
        && (!('status' in membership(orgId).data) || membership(orgId).data.status == 'active');
    }

    function isOrganizationEnabled(orgId) {
      let organization = firestore.get(/databases/(default)/documents/organizations/$(orgId)).data;
      return (!('platformStatus' in organization) || organization.platformStatus != 'suspended')
        && (!('subscription' in organization)
          || !('expiresAt' in organization.subscription)
          || organization.subscription.expiresAt >= request.time);
    }

    function hasDelegatedWorkspace(orgId) {
      let organization = firestore.get(/databases/(default)/documents/organizations/$(orgId)).data;
      return signedIn()
        && 'platformWorkspaceOrganizationId' in request.auth.token
        && 'platformWorkspaceRole' in request.auth.token
        && 'platformWorkspaceExpiresAt' in request.auth.token
        && 'platformWorkspaceAccessVersion' in request.auth.token
        && request.auth.token.platformWorkspaceOrganizationId == orgId
        && ((!('platformAccessVersion' in organization) && request.auth.token.platformWorkspaceAccessVersion == 0)
          || organization.platformAccessVersion == request.auth.token.platformWorkspaceAccessVersion)
        && request.auth.token.platformWorkspaceExpiresAt > request.time.toMillis();
    }

    function isPlatformAdminActive() {
      return firestore.exists(/databases/(default)/documents/platformAdmins/$(request.auth.uid))
        && platformAdmin().data.status == 'active';
    }

    function isMember(orgId) {
      return isOrganizationEnabled(orgId)
        && ((hasDelegatedWorkspace(orgId) && isPlatformAdminActive())
          || (!hasDelegatedWorkspace(orgId) && isMembershipActive(orgId)));
    }

    function canEdit(orgId) {
      return isOrganizationEnabled(orgId)
        && ((hasDelegatedWorkspace(orgId)
            && isPlatformAdminActive()
            && request.auth.token.platformWorkspaceRole in ['admin', 'editor'])
          || (!hasDelegatedWorkspace(orgId)
            && isMembershipActive(orgId)
            && membership(orgId).data.role in ['admin', 'editor']));
    }

    function allowedExtension(fileName) {
      return fileName.matches('.*\\.(pdf|PDF|png|PNG|jpg|JPG|jpeg|JPEG|dwg|DWG|dxf|DXF|docx|DOCX|hwpx|HWPX|xlsx|XLSX)$');
    }

    function allowedMime() {
      return request.resource.contentType.matches('application/pdf')
        || request.resource.contentType.matches('image/(png|jpeg)')
        || request.resource.contentType.matches('application/(vnd\\.openxmlformats-officedocument\\.(wordprocessingml\\.document|spreadsheetml\\.sheet)|octet-stream)')
        || request.resource.contentType.matches('image/vnd\\.dwg')
        || request.resource.contentType.matches('application/dxf')
        || request.resource.contentType.matches('application/haansofthwpx');
    }

    match /organizations/{orgId}/cases/{caseId}/attachments/{attachmentId}/{fileName} {
      allow read: if isMember(orgId);
      allow create, update: if canEdit(orgId)
        && request.resource.size <= 50 * 1024 * 1024
        && allowedExtension(fileName)
        && allowedMime();
      allow delete: if canEdit(orgId);
    }

    match /organizations/{orgId}/cases/{caseId}/documents/{documentId}/{fileName} {
      allow read: if isMember(orgId);
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
